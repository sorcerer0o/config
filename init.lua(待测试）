-- Treesitter and language-specific behavior --------------------------------

---@type table<string, string>
local treesitter_filetype_aliases = {
    jsonc = "json",
    objcpp = "objc",
    sh = "bash",
    tex = "latex",
    plaintex = "latex",
    bib = "bibtex",
}

for filetype, parser in pairs(treesitter_filetype_aliases) do
    vim.treesitter.language.register(parser, filetype)
end

local treesitter = require("nvim-treesitter")
treesitter.setup({
    install_dir = vim.fn.stdpath("data") .. "/site",
})

---@type UserTreeSitterState
local treesitter_state = {
    installed = {},
    installing = {},
}

for _, parser_name in ipairs(treesitter.get_installed()) do
    treesitter_state.installed[parser_name] = true
end

local parser_definitions = require("nvim-treesitter.parsers")

---@param filetype string
---@return string?
local function resolve_parser(filetype)
    local parser_name = treesitter_filetype_aliases[filetype] or vim.treesitter.language.get_lang(filetype) or filetype

    if parser_definitions[parser_name] then
        return parser_name
    end
end

---@param buffer integer
local function start_highlighting(buffer)
    vim.treesitter.start(buffer)
end

---@param parser_name string
local function start_buffers_for_parser(parser_name)
    for _, buffer in ipairs(api.nvim_list_bufs()) do
        if api.nvim_buf_is_loaded(buffer) and resolve_parser(vim.bo[buffer].filetype) == parser_name then
            start_highlighting(buffer)
        end
    end
end

---@param buffer integer
---@param filetype string
local function ensure_parser(buffer, filetype)
    local parser_name = resolve_parser(filetype)
    if not parser_name then
        return
    end

    if treesitter_state.installed[parser_name] then
        start_highlighting(buffer)
        return
    end

    if treesitter_state.installing[parser_name] then
        return
    end

    treesitter_state.installing[parser_name] = true
    local task = treesitter.install({ parser_name }, { summary = false })
    task:await(function(install_error)
        treesitter_state.installing[parser_name] = nil
        if install_error then
            return
        end

        treesitter_state.installed[parser_name] = true
        vim.schedule(function()
            start_buffers_for_parser(parser_name)
        end)
    end)
end

api.nvim_create_autocmd("FileType", {
    group = api.nvim_create_augroup("user_treesitter_lazy", { clear = true }),
    callback = function(event)
        ensure_parser(event.buf, event.match)
    end,
})

